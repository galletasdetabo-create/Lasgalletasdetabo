# Copia este archivo como .env.local (desarrollo) o configura estas variables en tu hosting.

# URL pública del sitio (sin barra final). En producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:7000

# Supabase (Project Settings > API). La clave publicable es segura en el navegador.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (service role). SOLO servidor: nunca la expongas ni la subas al repositorio.
SUPABASE_SECRET_KEY=

# Mercado Pago — Checkout API vía Orders (PSE). Vacío = PSE no se ofrece.
# test | production
MERCADOPAGO_ENVIRONMENT=test
# Access Token de la aplicación (credenciales de prueba o de producción)
MERCADOPAGO_ACCESS_TOKEN=
# Opcional (solo para integrar tarjetas en el futuro)
MERCADOPAGO_PUBLIC_KEY=
# Clave secreta de Webhooks (Tus integraciones > Webhooks > Configurar notificaciones)
MERCADOPAGO_WEBHOOK_SECRET=
# SOLO pruebas automatizadas: apunta al simulador local (scripts/mp-simulator.mjs). No usar en producción.
# MERCADOPAGO_API_BASE=http://127.0.0.1:4599
