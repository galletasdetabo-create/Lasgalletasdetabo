{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lasgalletasdetabo",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "lasgalletasdetabo" }],
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV" }],
  "d1_databases": [{ "binding": "NEXT_TAG_CACHE_D1", "database_name": "lasgalletasdetabo-tag-cache" }],
  "images": { "binding": "IMAGES" },
  "observability": { "enabled": true }
}
